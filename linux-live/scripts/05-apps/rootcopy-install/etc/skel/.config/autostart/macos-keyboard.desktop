[Desktop Entry]
Type=Application
Version=1.0
Name=macOS Style Firefox Fonts
Comment=Apply macOS-style Firefox fonts and settings on login
Exec=/home/live/bin/macos_style_firefox_fonts.sh
Terminal=false
StartupNotify=false
OnlyShowIn=XFCE;GNOME;KDE;LXDE;LXQt;MATE;Cinnamon;Unity;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
