! macOS style keyboard mapping for MiniOS
! Alt -> Cmd (Super), Win -> Alt (Option), CapsLock -> Control

clear control
clear mod1
clear mod4
clear lock

! Alt -> Cmd (Super), Win -> Alt (Option)
keycode 64  = Alt_L Meta_L
keycode 133 = Super_L
keycode 134 = Super_R
keycode 108 = Alt_R Meta_R

! CapsLock -> Control
keycode 66  = Control_L

! Navigation keys
keycode 110 = Home
keycode 115 = End
keycode 112 = Prior
keycode 117 = Next

! Reassign modifier keys
add control = Control_L Control_R
add mod1    = Alt_L Meta_L Alt_R Meta_R
add mod4    = Super_L Super_R
add lock    = Caps_Lock
