#!/bin/bash

# ========================================
# == Custom Packages Module             ==
# ========================================
# This module installs packages from your dotfiles/system-provision.sh
# Edit packages.list to add/remove packages.

set -e          # exit on error
set -o pipefail # exit on pipeline error
set -u          # treat unset variable as error

. /minioslib
. /minios_build.conf

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

console_colors

# ============================================
# Add Cloudflare WARP repository
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Setting up Cloudflare WARP repository..."
fi

install -m 0755 -d /usr/share/keyrings /etc/apt/sources.list.d

curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg \
    | gpg --yes --dearmor \
    --output /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg 2>/dev/null || true

chmod 0644 /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg 2>/dev/null || true

cat >/etc/apt/sources.list.d/cloudflare-client.list <<EOF
deb [signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] https://pkg.cloudflareclient.com/ ${DISTRIBUTION} main
EOF

apt-get update --allow-releaseinfo-change 2>/dev/null || true

# ============================================
# Install packages from list
# ============================================
/condinapt -l "${SCRIPT_DIR}/packages.list" -c "${SCRIPT_DIR}/minios_build.conf" -m "${SCRIPT_DIR}/condinapt.map"
if [ $? -ne 0 ]; then
    echo "Failed to install packages."
    exit 1
fi

# ============================================
# Install mise via curl (not apt)
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Installing mise..."
fi

# System-wide install: the plain installer would land in /root/.local/bin
# (invisible to the live user), so pin the path to /usr/local/bin.
curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh \
    || echo "WARNING: mise install failed"

# ============================================
# Apply macOS-style keyboard shortcuts
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Applying macOS-style keyboard shortcuts..."
fi

# Set keyboard layout to US Apple model with Ctrl/Win swap
setxkbmap -layout us -model apple 2>/dev/null || true
setxkbmap -option ctrl:swap_lwin_lctl 2>/dev/null || true

# Copy keyboard shortcuts to skel (for new users)
mkdir -p /etc/skel/.config/xfce4/terminal
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml

if [ -f "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/terminal/accels.scm" ]; then
    cp "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/terminal/accels.scm" \
       /etc/skel/.config/xfce4/terminal/accels.scm
fi

if [ -f "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml" ]; then
    cp "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml" \
       /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml
fi

# ============================================
# Setup Fcitx5 input method
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Setting up Fcitx5 input method..."
fi

# Write fcitx5 profile for new users
mkdir -p /etc/skel/.config/fcitx5
cat > /etc/skel/.config/fcitx5/profile << 'PROFILE_EOF'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=chewing

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=chewing
Layout=

[GroupOrder]
0=Default
PROFILE_EOF

# Set environment variables for input method
mkdir -p /etc/skel
cat >> /etc/skel/.xprofile << 'XPROFILE_EOF'
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS="@im=fcitx"
XPROFILE_EOF

# ============================================
# Refresh font cache
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Refreshing font cache..."
fi

fc-cache -fv >/dev/null 2>&1 || true

# ============================================
# Bake PingFang fonts into the live home (works offline on first boot)
# ============================================
# macos_style_firefox_fonts.sh otherwise downloads the fonts at login, but the
# first boot usually has no network yet, so /home/live/.local/share/fonts is
# left empty. Run it here with HOME=/home/live so the .otf files and the
# fontconfig rule are baked into the image. The Firefox step always fails at
# build time (no profile exists until Firefox has run once) - that is expected,
# so ignore the exit code; the login autostart finishes the Firefox part later.
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Baking PingFang fonts into /home/live/.local/share/fonts..."
fi

if [ -f /home/live/bin/macos_style_firefox_fonts.sh ]; then
    HOME=/home/live bash /home/live/bin/macos_style_firefox_fonts.sh \
        || echo "NOTE: PingFang bake returned non-zero (no Firefox profile at build is expected); see STEP 2 above for font clone status"
else
    echo "WARNING: /home/live/bin/macos_style_firefox_fonts.sh not found; PingFang fonts not baked"
fi

# ============================================
# Seed the baked live user home with skel configs
# ============================================
# /home/live is baked into the image by this module's rootcopy, and Debian's
# adduser skips the /etc/skel copy when the home dir already exists
# ("home directory already exists. Not touching this directory").
# Without this copy the live session gets no xfce4 theme/wallpaper,
# no panel config and no autostart entries. Must run LAST so all skel
# edits from earlier modules (04/05/07) are included.
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Seeding /home/live from /etc/skel..."
fi

if [ -d /home/live ]; then
    cp -a /etc/skel/. /home/live/
fi

echo "Custom packages installed successfully."
