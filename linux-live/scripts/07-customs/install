#!/bin/bash

# ========================================
# == Custom Packages Module             ==
# ========================================
# This module installs packages from your dotfiles/system-provision.sh
# Edit packages.list to add/remove packages.

set -e          # exit on error
set -o pipefail # exit on pipeline error
set -u          # treat unset variable as error

. /minioslib
. /minios_build.conf

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

console_colors

# ============================================
# Add Cloudflare WARP repository
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Setting up Cloudflare WARP repository..."
fi

install -m 0755 -d /usr/share/keyrings /etc/apt/sources.list.d

curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg \
    | gpg --yes --dearmor \
    --output /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg 2>/dev/null || true

chmod 0644 /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg 2>/dev/null || true

cat >/etc/apt/sources.list.d/cloudflare-client.list <<EOF
deb [signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] https://pkg.cloudflareclient.com/ ${DISTRIBUTION} main
EOF

apt-get update --allow-releaseinfo-change 2>/dev/null || true

# ============================================
# Install packages from list
# ============================================
/condinapt -l "${SCRIPT_DIR}/packages.list" -c "${SCRIPT_DIR}/minios_build.conf" -m "${SCRIPT_DIR}/condinapt.map"
if [ $? -ne 0 ]; then
    echo "Failed to install packages."
    exit 1
fi

# ============================================
# Install mise via curl (not apt)
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Installing mise..."
fi

curl -fsSL https://mise.run | bash 2>/dev/null || echo "WARNING: mise install failed"

# ============================================
# Apply macOS-style keyboard shortcuts
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Applying macOS-style keyboard shortcuts..."
fi

# Set keyboard layout to US Apple model with Ctrl/Win swap
setxkbmap -layout us -model apple 2>/dev/null || true
setxkbmap -option ctrl:swap_lwin_lctl 2>/dev/null || true

# Copy keyboard shortcuts to skel (for new users)
mkdir -p /etc/skel/.config/xfce4/terminal
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml

if [ -f "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/terminal/accels.scm" ]; then
    cp "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/terminal/accels.scm" \
       /etc/skel/.config/xfce4/terminal/accels.scm
fi

if [ -f "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml" ]; then
    cp "${SCRIPT_DIR}/rootcopy-install/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml" \
       /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml
fi

# ============================================
# Install screen.sh for resolution fix
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Installing screen.sh..."
fi

mkdir -p /usr/local/bin
if [ -f "${SCRIPT_DIR}/rootcopy-install/usr/local/bin/screen.sh" ]; then
    cp "${SCRIPT_DIR}/rootcopy-install/usr/local/bin/screen.sh" /usr/local/bin/screen.sh
    chmod +x /usr/local/bin/screen.sh
fi

# ============================================
# Refresh font cache
# ============================================
if [ "$VERBOSITY_LEVEL" -ge 1 ]; then
    echo "Refreshing font cache..."
fi

fc-cache -fv >/dev/null 2>&1 || true

echo "Custom packages installed successfully."
