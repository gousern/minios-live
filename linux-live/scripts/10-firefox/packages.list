firefox +d=bionic || firefox-esr +dp=debian || firefox-esr +dp=ubuntu -d=bionic

# English
firefox-locale-en +{lo=C|lo=en_US|ml=true|kl=true} +d=bionic || firefox-esr-locale-en +{lo=C|lo=en_US|ml=true|kl=true} +dp=ubuntu -d=bionic

# Chinese (Traditional)
firefox-locale-zh-hant +d=bionic || firefox-esr-l10n-zh-tw +dp=debian || firefox-esr-l10n-zh-tw +dp=ubuntu -d=bionic

# Chinese (Simplified)
firefox-locale-zh-hans +d=bionic || firefox-esr-l10n-zh-cn +dp=debian || firefox-esr-l10n-zh-cn +dp=ubuntu -d=bionic
